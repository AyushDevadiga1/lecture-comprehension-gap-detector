# Copy to `.env` in this directory. Vite only reads VITE_-prefixed vars, and
# only at `npm run dev` / `npm run build` time — a running dev server needs a
# restart after any change here.
#
# Every value is OPTIONAL. With no `.env` at all the app talks to the backend
# through the Vite proxy on the same origin and works for local dev, because the
# backend runs unguarded unless LECGAP_API_KEY is set on the *server*.

# Sent as the `X-API-Key` header on every request, and on the /jobs/stream
# reader. Required only when the server sets LECGAP_API_KEY. If you set it here
# but not on the server (or the other way round) you get 401 on everything.
# VITE_LECGAP_API_KEY=

# Where the API lives. Leave empty to use the Vite dev proxy (same origin), which
# is what you want in dev: it is why the SSE stream works without CORS.
# Set it only if you are pointing the built `dist/` at a real deployment.
# VITE_LECGAP_API_URL=

# Cap on generated quiz questions. The backend also does an even-spread sample
# across the course, so the questions cover the whole lecture rather than its
# opening concepts. Empty, unparseable, or out of range falls back to 15; the
# value is clamped into the 1-200 the API accepts. Sending no cap at all means
# one LLM call per concept — 153 of them for the `ml` course.
VITE_LECGAP_QUIZ_MAX_QUESTIONS=15

# Force the colour base instead of following the OS preference. `dark` is what
# the Streamlit engine declares and what the palette was tuned for; `light` is
# supported and contrast-pinned, but has not been looked at by a human.
# Unset = an explicit choice remembered in localStorage, defaulting to
# `prefers-color-scheme`.
# VITE_LECGAP_THEME_BASE=dark
