# LecGap environment configuration
# Copy this file to .env and fill in your values. (.env is git-ignored.)

# Required for LLM features (concept extraction). Get a free key:
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides (sensible defaults shown) ---
# Chat model used by the pipeline (Groq hosts these):
# LECGAP_GROQ_MODEL=openai/gpt-oss-20b
#
# Final-fallback local backend — only used if Groq is unavailable.
# No Ollama install needed for normal operation.
# LECGAP_OLLAMA_MODEL=llama3.2
# LECGAP_OLLAMA_URL=http://127.0.0.1:11434
#
# Local Whisper model size: tiny | base | small | medium | large-v3
# WHISPER_MODEL=base
#
# Database location override:
# LECGAP_DATABASE_URL=sqlite:///data/lecgap.db
