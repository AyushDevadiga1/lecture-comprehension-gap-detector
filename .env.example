# LecGap environment configuration
# Copy this file to .env and fill in your values. (.env is git-ignored.)
#
# backend/config.py is the single source of truth for this surface — keep this
# file in sync when a key or default there changes.

# Required for LLM features (concept extraction) and for fast hosted
# transcription (WHISPER_BACKEND=groq). Get a free key:
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides (sensible defaults shown) ---
# Chat model used by the pipeline (Groq hosts these):
# LECGAP_GROQ_MODEL=openai/gpt-oss-20b
#
# Final-fallback local backend — only used if Groq is unavailable.
# No Ollama install needed for normal operation.
# LECGAP_OLLAMA_MODEL=llama3.2
# LECGAP_OLLAMA_URL=http://127.0.0.1:11434
#
# Local Whisper model size: tiny | base | small | medium | large-v3
# WHISPER_MODEL=base
#
# Transcription backend: local (offline openai-whisper, default) | groq
# (~30x faster hosted whisper, needs GROQ_API_KEY + ffmpeg on PATH)
# WHISPER_BACKEND=local
# Only used when WHISPER_BACKEND=groq:
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_WHISPER_UPLOAD_LIMIT=25165824    # 24 MiB chunk cap; audio is auto-chunked
# GROQ_WHISPER_MAX_CHUNK_S=300          # hard per-request length cap (Groq 500 resilience)
# HTTP 429/500/rate-limit retries for whisper and LLM calls:
# LECGAP_WHISPER_RETRIES=2
# LECGAP_WHISPER_500_BACKOFF=5          # seconds between transient-500 retries
# LECGAP_LLM_RETRIES=2
# LECGAP_LLM_SLEEP_CAP_S=120            # max seconds between LLM retries
# LECGAP_LLM_CACHE_TTL_S=2592000        # cached completion TTL (30 days)
#
# Database location override:
# LECGAP_DATABASE_URL=sqlite:///data/lecgap.db
#
# API-key auth for the backend (when configured, non-exempt requests require
# X-API-Key or Bearer matching this; unset = open local dev):
# LECGAP_API_KEY=
#
# Upload / job / structure-pass knobs:
# LECGAP_MAX_UPLOAD_MB=2048             # 0 = no cap
# LECGAP_MAX_PIPELINE_JOBS=3            # concurrent heavy pipeline jobs (>=1)
# LECGAP_STRUCTURE_WINDOW_CHARS=8000
# LECGAP_STRUCTURE_OVERLAP_FRAC=0.25
# LECGAP_STRUCTURE_MAX_TOKENS=3000
#
# Clip cutting:
# LECGAP_CLIP_STREAMCOPY=0              # 1 = always stream-copy (instant/lossy-offset)
# LECGAP_CLIP_REENCODE_THRESHOLD_S=120  # spans above re-encode for frame accuracy
# LECGAP_CLIP_WORKERS=                  # default min(4, logical cores)
#
# Optional LLM behaviors:
# LECGAP_LLM_REASONING=0                # 1 = LLM second opinion on classifier edges
# LECGAP_SNAP_SILENCE=0                 # 1 = snap segment start to first speech sample
#
# Hub model-ID pinning (L10): the embedding encoder loaded from HuggingFace.
# Leave unset to use the default all-MiniLM-L6-v2; LECGAP_EMBEDDING_REVISION
# (a git commit sha) freezes the exact hub snapshot for reproducible runs.
# LECGAP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LECGAP_EMBEDDING_REVISION=
