# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Environments
.env
.venv/
venv/

# Data (raw lectures, processed artifacts, downloaded benchmark — never commit these)
data/raw/*
data/processed/*
data/lecturebank/*
data/models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/lecturebank/.gitkeep
!data/models/.gitkeep

# Generated clips / media
*.mp4
*.mp3
*.wav
*.webm
*.mkv

# Local DB
*.db
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Qodo / AI tool metadata (local only)
.qodo/

# Local working notes / progress tracker (never commit)
WORKLOG.md

# Local review scratch notes (never commit)
review_*.md

# pyvis bundled JS/CSS assets (recreated on every graph save)
/lib/

#security audit-skill
security-audit-skill

# SQLite WAL sidecars produced next to any lecgap.db (incl. data/samples runs)
**/*.db-shm
**/*.db-wal

# agent skills
agent-skills
improve-codebase-architecture-skill/

# Local agent configs
opencode.json

# Security audit run artifacts (never commit)
security-audits/

# Playwright E2E tier artifacts. `.e2e/` holds a throwaway seeded SQLite database
# and the backend.url file the dev-server proxy reads; test-results/ and
# playwright-report/ are regenerated on every run. None of it is source.
frontend-react/.e2e/
frontend-react/test-results/
frontend-react/playwright-report/


